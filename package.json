{
  "private": true,
  "name": "cloudflare-access-training-worker",
  "version": "3.0.0",
  "description": "Production-ready Cloudflare Worker implementing External Evaluation Rule for training-based access control with Zero Trust",
  "main": "index.js",
  "scripts": {
    "test": "npm run build:ui && vitest run",
    "test:watch": "vitest",
    "test:coverage": "npm run build:ui && vitest run --coverage",
    "build:ui": "node scripts/build-ui.mjs",
    "build": "npm run build:ui && npm run type-check",
    "predev": "npm run build:ui",
    "predeploy": "npm run build:ui",
    "format": "prettier --write '**/*.{ts,js,css,json,md}'",
    "type-check": "tsc --noEmit && tsc -p ui/tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit && tsc -p tests/ui/tsconfig.json --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "types": "wrangler types worker-configuration.d.ts --env-file .dev.vars.example --include-runtime=false --strict-vars=false",
    "types:check": "wrangler types worker-configuration.d.ts --env-file .dev.vars.example --include-runtime=false --strict-vars=false --check",
    "dev": "wrangler dev",
    "deploy": "npm run type-check && wrangler deploy"
  },
  "author": "James Royal <jroyal@cloudflare.com>",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.7.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.163.0"
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.18.1",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
